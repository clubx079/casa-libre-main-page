# casa-libre.com hub — environment variables.
# Copy to .env.local for local dev. NEXT_PUBLIC_* values are inlined at BUILD time.

# --- Email (contact form + book-a-call, via Resend) ---
RESEND_API_KEY=
RESEND_FROM=
# Where contact/call requests are sent.
CONTACT_EMAIL=
# Reply-To on the booking-link email (default hola@casa-libre.com.py).
CALL_REPLY_TO=
# Dev only: send the visitor email here instead of the visitor's address.
TEST_VISITOR_EMAIL=

# --- /llamada approve/decline links ---
# Booking link sent to approved callers (BOOKING_URL wins over NEXT_PUBLIC_BOOKING_URL).
BOOKING_URL=
NEXT_PUBLIC_BOOKING_URL=
# HMAC secret for the signed /llamada links (default derived from RESEND_API_KEY).
CALL_LINK_SECRET=
# Public origin used in those links, e.g. https://casa-libre.com
SITE_URL=

# --- PostHog analytics (same project as the country buyer sites) ---
# Optional: lib/analytics.js falls back to these exact values when empty (they often
# are at build on AiroStack). The phc_ key is a public, client-side key.
NEXT_PUBLIC_POSTHOG_KEY=phc_zq43Nbyp5PNGF6xjedrhqAnzHrZAQaXsNn6iqrT5cvyy
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
